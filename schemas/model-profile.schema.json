{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PenStairs/claude-codex-visual-benchmark/blob/main/schemas/model-profile.schema.json",
  "title": "Visual benchmark model profile",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "id", "displayName", "model", "provider", "authentication", "reasoning", "supportedMethods"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9.]+(?:-[a-z0-9.]+)*$" },
    "displayName": { "type": "string", "minLength": 1 },
    "enabled": { "type": "boolean" },
    "runner": { "enum": ["codex", "claude"], "default": "codex" },
    "model": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "baseUrl": { "type": "string", "format": "uri" },
        "wireApi": { "enum": ["responses", "anthropic"] },
        "requiresOpenAIAuth": { "type": "boolean" }
      }
    },
    "authentication": {
      "oneOf": [
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "codex-login" } }, "additionalProperties": false },
        { "type": "object", "required": ["type"], "properties": { "type": { "const": "claude-login" } }, "additionalProperties": false },
        {
          "type": "object",
          "required": ["type", "environmentVariable"],
          "properties": {
            "type": { "const": "environment" },
            "environmentVariable": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
            "header": { "enum": ["bearer", "x-api-key"] }
          },
          "additionalProperties": false
        }
      ]
    },
    "reasoning": {
      "type": "object",
      "required": ["default", "allowed"],
      "properties": {
        "default": { "type": "string" },
        "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
        "control": { "type": "string" }
      }
    },
    "supportedMethods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["threejs", "twigl"] }
    }
  }
}
