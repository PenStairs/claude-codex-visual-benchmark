      "sha256": "70c34019e4ecf4bf11dbf4dcc506bd79bfd723052e1b15fb03ff0b2c12f3873e",
      "startSeconds": 4,
      "volume": 0.25,
      "fadeInSeconds": 0.25,
      "fadeOutSeconds": 0.75,
      "codec": "aac",
      "bitrateBitsPerSecond": 192000,
