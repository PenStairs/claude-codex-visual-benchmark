{
  "schemaVersion": 1,
  "id": "deepseek-v4.1-flash-claude",
  "displayName": "DeepSeek V4.1 Flash (Claude Code)",
  "enabled": true,
  "runner": "claude",
  "model": "deepseek-flash",
  "provider": {
    "id": "deepseek",
    "name": "DeepSeek",
    "baseUrl": "https://api.deepseek.com/anthropic",
    "wireApi": "anthropic"
  },
  "authentication": {
    "type": "environment",
    "environmentVariable": "DEEPSEEK_API_KEY",
    "header": "bearer"
  },
  "reasoning": {
    "default": "max",
    "allowed": [
      "low",
      "high",
      "max"
    ],
    "control": "effort-flag"
  },
  "supportedMethods": [
    "threejs",
    "twigl"
  ]
}
